function load_env() {
    local data="$1"
    local count=0
    local errors=0

    eval "data_expanded=\"$data\""

    echo -e "${cyanH}=== Caricamento variabili d'ambiente ===${resetColor}"

    while IFS= read -r line; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

        line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
            local var_name="${BASH_REMATCH[1]}"
            local var_value="${BASH_REMATCH[2]}"

            # rimuove apici
            var_value="${var_value#\"}"
            var_value="${var_value%\"}"
            var_value="${var_value#\'}"
            var_value="${var_value%\'}"

            ((count++))

            if [[ "$var_value" == /* ]]; then
                if [[ -e "$var_value" ]]; then
                    echo -e "  ${green}✓${resetColor} $var_name='$var_value'"
                else
                    echo -e "  ${red}✗${resetColor} ${yellowH}WARNING:${resetColor} $var_name='$var_value' ${red}(path NON esiste)${resetColor}"
                    ((errors++))
                fi
            else
                echo -e "  ${green}→${resetColor} $var_name='$var_value'"
            fi

            export "$var_name=$var_value"
        fi
    done <<< "$data_expanded"

    echo -e "${cyanH}=== Caricamento completato: ${green}$count variabili${resetColor}"
    if [[ $errors -gt 0 ]]; then
        echo -e "${yellowH}⚠ Attenzione: ${red}$errors path non trovati${resetColor}"
    fi
    echo
}



