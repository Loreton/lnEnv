# alias ${alias_shell_prefix}gitcommit="${ln_SH_SCRIPTS_DIR}/varie/gitcommit.sh"
alias ${alias_prefix}gitcommit="${ln_PY_SCRIPTS_DIR}/git_commit/main.py"
