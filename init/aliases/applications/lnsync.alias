alias ${alias_prefix}lnsync.lnpi31='${LNSYNC_PGM} 	    --dry-run --prof lnpi31'
alias ${alias_prefix}lnsync.lnpi51='${LNSYNC_PGM} 	    --dry-run --prof lnpi51'
alias ${alias_prefix}lnsync.ezsilvia='${LNSYNC_PGM} 	--dry-run --prof ezbook_silvia'
alias ${alias_prefix}lnsync.wd264f_500gb='${LNSYNC_PGM} --dry-run --prof WD264F_500GB'