function .nmap.cmd_list() {
    # ip=${1:-'192.168.0.1/24'}
    # port=${2:-'80'}
    # CMD="nmap -T4 -A ${ip} -p${port}"
    # echo -e "${TAByellowH}executing command:
    # $CMD (optional -v[v] verbose -Pn)${colorReset} "
    # $CMD
    echo "  -sS (TCP SYN scan) - TCP stack"
    echo "  -sU (UDP scans)"
    echo "  -sT (TCP connect scan)"
    echo "  -PU (ping port)"
    echo "      sudo nmap -sU -pU:53,67,68,161,162 192.168.1.9 (ottima)"
    echo "      sudo nmap -sT -pT:22,23,80,8080 192.168.1.9"
    echo "      sudo nmap -PU -pU:67 192.168.1.9"
    echo "      sudo nmap 192.168.1.9 -p 80"
    echo "      sudo nmap 192.168.1.9 -p 80-200"
    echo "      sudo nmap -sn 192.168.1.0/24"
    echo "      sudo nmap -sP 192.168.1.0/24 (include MAC Address obbligatorio il sudo)"

    echo "      sudo arp-scan --interface=enp2s0 --localnet"
    echo "      sudo netdiscover -(P)r 192.168.1.0/24"
}




alias ${alias_prefix}nmap.lnmqtt="nmap lnmqtt.duckdns.org -p1883"
alias ${alias_prefix}nmap.23="nmap lnmqtt.duckdns.org -p23022"
alias ${alias_prefix}nmap.31="nmap lnmqtt.duckdns.org -p31022"
alias ${alias_prefix}nmap.51="nmap lnmqtt.duckdns.org -p51022"
