#!/bin/bash

function @set_xclip_vars() {
    echo "${PWD}" >>"${ln_XCLIP_EXTRA_DIRS}"
    if [[ -f ${ln_XCLIP_PROJECT_VARS_FILE} ]]; then
       echo "running ${ln_XCLIP_PROJECT_VARS_FILE}"
       /usr/bin/bash "${ln_XCLIP_PROJECT_VARS_FILE}"
    fi
}

if [[ " ${lapTopPC_lc} " == *" ${hostname_lc} "* ]]; then
    mkdir -p "${ln_XCLIP_TEMP_DIR}"

    ###... per aprire un file selezionato nella shell (vedi anche $HOME/.xbindkeysrc)
    alias ${alias_prefix}xclip.clipboard="${ln_XCLIP_DIR}/xClip.py --clipboard"
    alias ${alias_prefix}xclip.primary="${ln_XCLIP_DIR}/xClip.py --primary"
    # alias ${alias_prefix}xclip.zed.edit=".zed ${ln_PY_SCRIPTS_DIR}/xClip/xClip.py"


    # save current dir in file
    # alias ${alias_prefix}xclip.topdir='file=/tmp/xclip/extra_top_dirs.txt && { echo "$PWD" >$file; echo "file $file"; cat $file;  }'  ### importante il singolo apice

    # add current dir in file
    alias ${alias_prefix}xclip.vars="@_set_xclip_vars"

fi
