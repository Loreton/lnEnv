#
# updated by ...: Loreto Notarantonio
# Date .........: 14-08-2026 13.36.29
#




function @_to_xclip_vars() {
    file=${XCLIP_EXTRA_ENVARS}
    echo "$@" >> ${file}
    echo "file $file"
    cat $file
}

if [[ " ${lapTopPC_lc} " == *" ${hostname_lc} "* ]]; then

    ###... per aprire un file selezionato nella shell (vedi anche $HOME/.xbindkeysrc)
    alias ${alias_prefix}xclip.zed.clipboard="${ln_PY_SCRIPTS_DIR}/xClip/xClip.py --root-dir-file /tmp/xclip.rootdir --zed --clipboard"
    alias ${alias_prefix}xclip.zed.primary="${ln_PY_SCRIPTS_DIR}/xClip/xClip.py --root-dir-file /tmp/xclip.rootdir --zed --primary"
    alias ${alias_prefix}xclip.zed.edit=".zed ${ln_PY_SCRIPTS_DIR}/xClip/xClip.py"


    # save current dir in file
    alias ${alias_prefix}xclip.cd='file=${XCLIP_ROOT_DIR_FILE} && { echo "$PWD" >$file; echo "file $file"; cat $file;  }'  ### importante il singolo apice

    # add current dir in file
    alias ${alias_prefix}xclip.vars='@_to_xclip_vars'


fi
