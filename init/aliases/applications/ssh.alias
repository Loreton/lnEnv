function @_tunnel_casetta() {
    local fExecute=${1:-no_go}
    local  ArcherC6='-L8002:192.168.5.2:80'
    local ArcherC20='-L8003:192.168.5.3:80'
    local    CPE210='-L8006:192.168.1.6:443'
    local    EAP110='-L8007:192.168.1.7:80'
    local   MQTT_31='-L8883:192.168.3.1:1883'

    echo -e "${TAByellowH}CPE210:    https://localhost:${CPE210: 2:4}"
    echo -e "${TAByellowH}EAP110:    http://localhost:${EAP110: 2:4}"
    echo -e "${TAByellowH}ArcherC6:  http://localhost:${ArcherC6: 2:4}"
    echo -e "${TAByellowH}ArcherC20: http://localhost:${ArcherC20: 2:4}"
    echo -e "${TAByellowH}MQTT_31:   http://localhost:${MQTT_31: 2:4}"
    # echo -e "${TAByellowH}localhost:22001 to archerC6:22"
    # echo -e "${TAByellowH}localhost:22002 to archerC20:22"
    local bridgeServer="pi@lncasetta.mooo.com -p 22051"
    cmd="ssh -N \
            ${MQTT_31} \
            ${ArcherC6} \
            ${ArcherC20} \
            ${CPE210} \
            ${EAP110} \
            ${bridgeServer}"

    echo -e ${TABcyanH}$cmd
    [[ "$fExecute" == '--go' ]] && $cmd || echo -e "\n${TABgreen}Enter --go to execute command\n"
}

alias ${alias_prefix}tunnel.8443.bev07="ssh -L8443:beverinoa07.crabdance.com:443 pi@beverinoA07.crabdance.com -p 41022"
alias ${alias_prefix}tunnel.8443.bev09="ssh -L8443:beverinoa09.crabdance.com:443 pi@beverinoA09.crabdance.com -p 41022"

# alias ${alias_prefix}tunnel.router_casetta_8080="ssh -L8080:192.168.1.1:80 pi@lncasetta.duckdns.org -p 22051"
# alias ${alias_prefix}tunnel.mqtt_casetta_1883="ssh -L1883:192.168.1.31:1883 pi@lncasetta.duckdns.org -p 22051"

alias ${alias_prefix}tunnel.casetta="@_tunnel_casetta"


