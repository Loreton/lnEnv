function .ssh() {
    ssh pi@192.168.1.${1}
}

function .mexec() {
    local command="$@"
    hosts='pi@192.168.1.22 pi@192.168.1.23 pi@192.168.1.31 pi@192.168.1.41  pi@beverinoA07.crabdance.com'
    hosts='pi@192.168.1.41'
    for host in $hosts; do
        echo
        echo -e "${TABcyanH}------------------------------------------"
        echo -e "${TAB} on server: ${host}"
        echo -e "${TAB}------------------------------------------$colorReset"
        ssh -o ConnectTimeout=5 ${host} "$command"
    done
}



