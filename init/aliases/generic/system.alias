function @ln_grep() {
    grep -ri $1 * .[^.]*
    grep --include=\*.{sh,py} --exclude=\*.o -rnw '/path/to/somewhere/' -e 'pattern'
}



if [[ "XXX" == "NOT_USING" ]]; then
    alias ${alias_prefix}commit="${ln_SH_SCRIPTS_DIR}/prod/gitcommit.sh"
    alias ${alias_prefix}reset="tput reset"

    ### - system
    alias ${alias_prefix}update.sys='sudo apt update -y && sudo apt upgrade -y'
    alias ${alias_prefix}upgrade.pkg='sudo dpkg -i' ### package like ipscan_3.6.2_amd64.deb

    alias ${alias_prefix}pid="sudo ps -fp " # anche cat /proc/<pid>/cmdline

    alias ps1="export PS1='\[\033[01;32m\][\u@\h] \[\033[01;34m\][\W]\$:\[\033[00m\] '"
    alias ps2="export PS1='\[\033[01;32m\][\u@\h\[\033[00m\]] \[\033[01;34m\][\w] \$:\[\033[00m\] '"

    alias ${alias_prefix}motd.update="sudo ln -sf ${ln_CONFIG_DIR}/pc/${hostname_lc}/etc_motd /etc/motd && ls -la /etc/motd"
    alias ${alias_prefix}mqtt-retained_clear="mosquitto_pub -h lnmqtt.duckdns.org  -u Loreto -P LoretoMqtt -n -r -d -t " # passare topic: tele/VesoviNew/LWT

    alias ${alias_prefix}readOnly="chmod -R a-w"
    alias ${alias_prefix}writeUser="chmod -R u+w"
fi


alias ${alias_prefix}reset_screen="tput reset"


alias ls='ls'
alias ll='ls -al --color'
alias lr='ls -latr --color'


