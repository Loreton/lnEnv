if [[ " ${lapTopPC_lc} " == *" ${hostname_lc} "* ]]; then


    # alias ${alias_prefix}editor=$(which subl_byLoreto)
    _TAB='    '
    _dq='"'
    alias ${alias_prefix}usbview-02="usb-devices && { echo;
                                                      echo ${_dq}${_TAB}USB 1.1: Spd=12${_dq};
                                                      echo ${_dq}${_TAB}USB 2.0: Spd=480${_dq};
                                                      echo ${_dq}${_TAB}USB 3.0: Spd=5000${_dq};
                                                      echo; }"
    alias ${alias_prefix}usbview-01="lsusb -t && { echo;
                                                   echo ${_dq}${_TAB}USB 1.1: 12M${_dq};
                                                   echo ${_dq}${_TAB}USB 2.0: 480M${_dq};
                                                   echo ${_dq}${_TAB}USB 3.0: 5000M${_dq};
                                                   echo; }"
    unset _TAB
    unset _dq



    alias ${alias_prefix}real_path='echo $(readlink -fvs  "${PWD}")';

    alias ${alias_prefix}sysbench-cpu="sysbench cpu --cpu-max-prime=20000 run";
    alias ${alias_prefix}sysbench-mem="sysbench memory --memory-block-size=1M --memory-total-size=5G run";
    alias ${alias_prefix}sysbench-mysl="sysbench oltp_read_write --db-driver=mysql --mysql-user=loreto --mysql-password=Loreto --tables=10 --table-size=100000 run";
    # alias ${alias_prefix}key_code="xmodmap -pke | grep -E 'keycode\s+(45|53|9)'"
    alias ${alias_prefix}key_code="xmodmap -pke | grep -E 'keycode\s+()'"



elif [[ " ${raspberryPC} " == *" ${hostname_lc} "* ]]; then
    export editor=/usr/bin/vi
    export EDITOR=/usr/bin/vi
fi

