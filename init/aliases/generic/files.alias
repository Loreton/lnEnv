if [[ " ${lapTopPC_lc} " == *" ${hostname_lc} "* ]]; then
    # _TAB='    '
    # _dq='''
    alias ${alias_prefix}filesAttributes='${ln_UTILS_DIR}/setFiles/setFilesReadOnly.sh'
    # alias ${alias_prefix}filesVerify='verifyAttributes'
    alias ${alias_prefix}fileAllReadOnly1='echo find . -type f -exec chmod 444 {} +' # Raccoglie più file e li passa come argomenti in UNA SOLA esecuzione (simile a xargs).
    alias ${alias_prefix}filePatternROnly='echo find . -type f -name "*.mp3" -exec chmod 444 {} \;' # Esegue il comando UNA VOLTA per ogni file trovato.
    # alias ${alias_prefix}filesReadOnly2='echo find . -type f \( -name '*.py' -o -name '*.cpp' -o -name '*.h' \) -exec chmod -w {} \;'
    # alias ${alias_prefix}filesReadOnly3='echo find . -type f \( -name '*.py' -o -name '*.cpp' -o -name '*.h' \) -print0 \| xargs -0 chmod -w'
    # alias ${alias_prefix}filesReadOnly_verify='echo find /path/to/dir -type f \( -name '*.py' -o -name '*.cpp' -o -name '*.h' \) -ls'
    # alias ${alias_prefix}filesAnDirReadOnly='echo find . -type f -exec chmod 555 {} +'

    alias ${alias_prefix}todo='.subl /home/loreto/filu/lnEnv/Notes/todo.yaml'
    alias ${alias_prefix}serietv='.subl /home/loreto/filu/lnEnv/Notes/SerieTV.yaml'
    alias ${alias_prefix}film='.subl /home/loreto/filu/lnEnv/Notes/film.yaml'


    #----- find text in files
    alias ${alias_prefix}fr.lnEnv='${ln_UTILS_DIR}/findAndReplace/findReplaceTextInFiles.py --top-dir=${ln_ENV_DIR}'
    alias ${alias_prefix}fr.pwd='${ln_UTILS_DIR}/findAndReplace/findReplaceTextInFiles.py --top-dir=${PWD} $@'
    alias ${alias_prefix}fr.ask='${ln_UTILS_DIR}/findAndReplace/findReplaceTextInFiles.py $@'
fi

