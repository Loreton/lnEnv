if [[ " ${lapTopPC_lc} " == *" ${hostname_lc} "* ]]; then
    function @file-read-only() {
        echo
        echo "# ---- con il ; finale esegue il comando UNA VOLTA per ogni file trovato"
        echo -e "\tfind . -type f -name '*.mp3' -exec chmod -w {} \;"
        echo -e "\tfind . -type f \( -name '*.py' -o -name '*.cpp' -o -name '*.h' \) -exec chmod -w {} \;"
        echo
        echo "# ---- Con il + finale raccoglie più file e li passa come argomenti in UNA SOLA esecuzione (simile a xargs)."
        echo "# ---- ovviamente molto più veloce"
        echo -e "\tfind . -type f -name '*.mp3' -exec chmod -w {} +"
        echo -e "\tfind . -type f \( -name '*.py' -o -name '*.cpp' -o -name '*.h' \) -print0 \| xargs -0 chmod -w"
    }


    alias ${alias_prefix}todo='.subl /home/loreto/filu/lnEnv/Notes/todo.yaml'
    alias ${alias_prefix}serietv='.subl /home/loreto/filu/lnEnv/Notes/SerieTV.yaml'
    alias ${alias_prefix}film='.subl /home/loreto/filu/lnEnv/Notes/film.yaml'


    #----- find text in files
    alias ${alias_prefix}fr.lnEnv='${ln_PY_SCRIPTS_DIR}/findAndReplace/findReplaceTextInFiles.py --top-dir=${ln_ENV_DIR}'
    alias ${alias_prefix}fr.pwd='${ln_PY_SCRIPTS_DIR}/findAndReplace/findReplaceTextInFiles.py --top-dir=${PWD} $@'
    alias ${alias_prefix}fr.ask='${ln_PY_SCRIPTS_DIR}/findAndReplace/findReplaceTextInFiles.py $@'
fi
