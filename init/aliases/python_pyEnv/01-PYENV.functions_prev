    ~/.config/starship.toml

        add_newline = false

        format = """
        $directory\
        $python\
        $git_branch\
        $git_status\
        $character
        """

        [python]
        symbol = "🐍 "
        format = "[$symbol$version]($style) "

        [directory]
        style = "cyan bold"

        [character]
