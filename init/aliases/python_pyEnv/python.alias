alias ${alias_py_prefix}list="pip list"
alias ${alias_py_prefix}outdate="pip list --outdated"
alias ${alias_py_prefix}upgrade_pip="pip install upgrade setuptools && python3 -m pip install -U pip" ### nell'ordine


alias ${alias_venv_prefix}list="pip list"
