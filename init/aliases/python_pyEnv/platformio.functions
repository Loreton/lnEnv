function @setPlatformio() {
    if ! declare -F @createLink > /dev/null; then
        source create_links.functions
    fi
    export fEXECUTE="--go" ### fEXECUTE
    @createLink ${HOME}/.platformio/penv  .venv
    @createLink ${ln_UTILS_DIR}/py_env/ln_venv_activate_master .lnactivate
    source .lnactivate

    @createLink ${ln_START_PROC_DIR}/piorun.sh ./.piorun
}


:<<'COMMENT_PER_PLATFORMIO'
creare un python generico:
    mkdir $HOME/genericPython
    cd $HOME/genericPython
    .pyenv.setup_default
    .venv.create.3.13.9 generic (viene creato un python nella dir \${VENV_ROOT}/generic_3.13.9)
    . .lnactivate

    a questo punto se si vuole si puÃ² installare platformio:
    ...installare i moduli python se mancano....
    wget -O get-platformio.py https://raw.githubusercontent.com/platformio/platformio-core-installer/master/get-platformio.py
    python3 get-platformio.py
    deactivate

    andare sotto la directory del progetto che deve utilizzare platformio
    ed eseguire il comando @setPlatformio (funzione definita sopra)
COMMENT_PER_PLATFORMIO




