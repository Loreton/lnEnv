### obbligatorio perché potrebbe essere chiamato prima di importare le path per COMMON_FUNCTIONS
pwd="${BASH_SOURCE%/*}" ###. get parent dir
if ! declare -F @lnLog > /dev/null;     then source ${pwd}/ln_log.functions; fi
if ! declare -F @setColors > /dev/null; then source ${pwd}/colors.functions; fi
unset pwd


# ##########################################################################################
# Funzione per controllare se un percorso esiste nella variabile PATH.
# Ritorna:
#   1 (Successo): Il percorso è presente in $PATH.
#   0 (Fallimento): Il percorso NON è presente in $PATH.
#
# ##########################################################################################
function @existsInPath() {
    local req_path="$1"
    @lnLog "${cyan}checking for ${yellow}${req_path}${cyan} in PATH"

    # 1. Controlli preliminari
    if [ -z "$req_path" ]; then
        @lnLog "${redH}ERROR: Percorso ${yellow}${req_path}${redH} non specificato"
        return 1
    fi

    # 2. Prepara la variabile PATH per una corrispondenza esatta
    # Aggiungendo ":" all'inizio e alla fine si assicura che il percorso sia
    # confrontato come un elemento separato (es. ":/bin:").
    local myPATH=":$PATH:"
    local path_pattern=":${req_path}:"

    # 3. Usa l'espressione 'case' per la verifica (efficiente in Bash)
    # if [[ "${myPATH}" == *":${req_path}:"* ]]; then
    case "$myPATH" in
        *"$path_pattern"*)
            @lnLog "${cyan}Path ${yellow}${req_path}${cyan}  already present in PATH"
            return 0  # Successo (ESISTE)
            ;;
        *)
            @lnLog "${cyan}Path ${yellow}${req_path}${cyan}  NOT present in PATH"
            return 1  # Fallimento (NON ESISTE)
            ;;
    esac
}



# ##########################################################################################
# Funzione per rimuovere un path specifico dalla variabile PATH, solo se è presente
# Uso: remove_from_path_if_exists "/path/da/rimuovere"
# ##########################################################################################
function @removePath() {
    local path_to_remove="$1"

    # --- 3. Logica di rimozione (Eseguita solo se il path esiste) ---
    if @existsInPath $path_to_remove; then
        @lnLog "${cyan}removing ${yellow}${path_to_remove}${cyan} to \$PATH"

        # 2. Prepara la variabile PATH per una corrispondenza esatta
        # Aggiungendo ":" all'inizio e alla fine si assicura che il percorso sia
        local myPATH=":$PATH:"
        local path_pattern=":${path_to_remove}:"
        local new_path="${myPATH//${path_pattern}/:}" # Sostituisci il pattern ":/path/to/remove:" con un singolo ":"

        # Rimuovi i ":" iniziali o finali che potrebbero essere rimasti.
        new_path="${new_path%:}"  # Rimuovi il ":" finale
        new_path="${new_path#:}"  # Rimuovi il ":" iniziale

        export PATH="$new_path"
        @lnLog "${cyan}Successo: Percorso rimosso: $path_to_remove"
    fi
}


# ##########################################################################################
# Funzione per aggiungere un path specifico dalla variabile PATH, solo se non è presente
# Uso: add_path "/path/da/rimuovere"
# ##########################################################################################
function @add_path() {
    local path_to_add="$1"

    if ! @existsInPath $path_to_add; then
        @lnLog "${cyan}adding ${yellow}${path_to_add}${cyan} in \$PATH"
        export PATH="$PATH:$path_to_add"
    fi
}

# ##########################################################################################
# Funzione per aggiungere un path specifico dalla variabile PATH, solo se non è presente
# Uso: add_path "/path/da/rimuovere"
# ##########################################################################################
function @insert_path() {
    local path_to_insert="$1"

    if ! @existsInPath $path_to_insert; then
        @lnLog "${cyan}inserting ${yellow}${path_to_insert}${cyan} in \$PATH"
        export PATH="${path_to_insert}:$PATH"
    fi
}







function @_testPath() {
    # --- ESEMPIO DI UTILIZZO ---

    PATH_TO_CHECK="/home/loreto/filu/lnEnv/init/commonFunctions"
    PATH_TO_CHECK="/usr/local/sbin"

    # echo "Controllo per '$PATH_TO_CHECK':"
    exists=$(path_exists_in_path "$PATH_TO_CHECK")
    echo $exists
    @existsInPath "$PATH_TO_CHECK"; exists=$?
    echo $exists

    if ! @existsInPath "$PATH_TO_CHECK"; then
        echo "Risultato: NON ESISTE (Exit Code: $?)"
    else
        echo "Risultato: ESISTE (Exit Code: $?)"
    fi

    # remove_from_path_if_exists "$PATH_TO_CHECK"
}



if ! declare -F @lnLog > /dev/null; then
    source ln_log.functions
fi
