function has_substring() {
    [[ "$1" == *"$2"* ]]
}



function @_ln_leftStr() {
    local defaultPad=' '
    local str=$1
    local len=$2
    local pad="${3:-${defaultPad}}"
    while ((${#str} < len)); do
      str+=$pad
    done
    echo "$str"
}




###  @_ln_create_link  "${HOME}/lnprofile" "$HOME/.ln" "--go"
function @_ln_create_link() {
    dir_name=$1
    link_name=$2
    action=$3
    # set -x
    if [[ -d "$dir_name" ]]; then
        cmd="ln -sf $dir_name $link_name"

        d_command="${cyanH}$(@_ln_leftStr $dir_name 60 ' ') ${blueH}${link_name}"
        echo -en "${yellowH}[$action] ${d_command} ${colorReset}"

        ### verifica se link esiste di giÃÂÃÂ 
        if [[ -d $link_name ]]; then
            local real_FullPath="$(readlink -fvs  $link_name)"
            if [[ $real_FullPath == $dir_name ]]; then
                echo -e "${yellowH}(already exists)"
            else
                echo -e "${TABredH}wrong link"
                echo -e "${TAB}${TAByellowH}new link will point to: ${purpleH}${dir_name}"
                [[ "$action" == "--go" ]] && rm -f $link_name && $cmd
            fi
        else
            echo -e "${yellowH}not exists"
            echo -e "${TAB}${TAByellowH}creating link"
            [[ "$action" == "--go" ]] && $cmd
        fi

    else
        echo -e "${TABredH}$dir_name not exists"
    fi
}


