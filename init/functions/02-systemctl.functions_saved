function @_rw_speed() {
    file_name=$1
    if [[ -z "$file_name" ]]; then
        echo
        echo
        echo -e "${TAByellowH}please enter fullpath filename and filesize"
        echo -e "${TAB}ex.:$cyanH"
        echo -e "${TAB}${TAB}/media/loreto/LnDisk_SD_ntfs/tmp/speed.text 100M"
        echo -e "${TAB}${TAB}/media/loreto/SD1TB_FAT32/tmp/speed.test    100M"
        echo -e "${TAB}${TAB}/tmp/speed.test 100M"
        echo
        return
    fi
    [[ -f "$file_name" ]] && rm -f ${file_name}
    echo "checking write speed on file: ${file_name}"
    file_size="100M"
    dd if=/dev/zero of="${file_name}" bs=${file_size} count=1 oflag=dsync
    echo "checking read speed on file: $file_name"
    dd if="${file_name}" of=/dev/zero bs=${file_size} count=1 oflag=dsync
    [[ -f "${file_name}" ]] && rm -f ${file_name}
}


