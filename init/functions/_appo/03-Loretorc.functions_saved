function lnLog() {
    local offset=0
    # Controlla se il primo argomento ÃÂ¨ un intero (positivo o negativo)
    if [[ "$1" =~ ^-?[0-9]+$ ]]; then
        offset=$1
        shift 1
    fi

    local stacklen=${#BASH_LINENO[@]}
    local script="${BASH_SOURCE[1]}"
    local func="${FUNCNAME[1]:-MAIN}"
    local line=$(( ${BASH_LINENO[0]:-0} + offset ))
    local caller="${func}:${line}"
    echo -e "${blueH}[${caller}]: $@"
}

