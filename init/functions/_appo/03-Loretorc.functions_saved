function _ln_getwinvar() {
    local varname=$1
    local win_var_value=$(cmd.exe /C echo "%${varname}%"|tr -d '\r')
    # wslpath syntax
    #   -a    force result to absolute path format
    #   -u    translate from a Windows path to a WSL path (default)
    #   -w    translate from a WSL path to a Windows path
    #   -m    translate from a WSL path to a Windows path, with Ã¢ÂÂ/Ã¢ÂÂ instead of Ã¢ÂÂ\\Ã¢ÂÂ
    lnx_var_value=$(wslpath -u -a "$win_var_value")
    echo $lnx_var_value
}


function @_example_local_esegui() {
    local stacklevel=$1
    local CMD_DESCR=$2
