function caller() {
    local funcname="$blueH${FUNCNAME[1]}"
    rCode=1
    bash_source_01=${BASH_SOURCE[1]}; lineno_01=${BASH_LINENO[1]}
    bash_source_02=${BASH_SOURCE[2]}; lineno_02=${BASH_LINENO[2]}

