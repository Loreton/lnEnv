function createEnvarFile() {
    local DATE=$(date +"%d-%m-%y %H:%M:%S")
    local fileout=$1
    local DATE=$(date +"%d-%m-%y %H:%M:%S")

    echo "#!/usr/bin/bash"                                 1>$fileout
    echo "#"                                               1>>$fileout
    echo "# dynamically created on $DATE"                  1>>$fileout
    echo "# do not edit because it will be overwritten!"   1>>$fileout
    echo "#"                                               1>>$fileout
    local result=$(env | grep "ln_")
    for x in $result; do
        echo $x  1>>$fileout
    done
    # unset -f createEnvarFile
    # set -x
    unset -f ${FUNCNAME[0]}
    # set +x
    # read

}


# -----------------------------------------------
# - Creazione file YAML allineato
# - $yamlFile    contiene le variabili non risolte
# -----------------------------------------------
function createYamlEnvarFile_unresolved() {
    local yamlFile=$1
    local DATE=$(date +"%d-%m-%y %H:%M:%S")
    echo "---"                                             >$yamlFile
    echo "#"                                               >>$yamlFile
    echo "# dynamically created on $DATE"                  >>$yamlFile
    echo "# do not edit because it will be overwritten!"   >>$yamlFile
    echo "#"                                               >>"$yamlFile"
    echo "system_envars:"                                  >>"$yamlFile"
    PAD='                                                    '

    for key in "${!env_vars[@]}"; do
        # facciamo il padding della key e tronchiamo a max_len
        var_name="${key}:$PAD"
        var_name="${var_name:0:max_len}"

        echo "${TAB}${var_name} \"${env_vars[$key]}\"" >> "$yamlFile"
    done
    # unset -f createYamlEnvarFile_unresolved
    unset -f ${FUNCNAME[0]}
}



# -----------------------------------------------
# - Creazione file YAML allineato
# - $yamlFile  contiene le variabili risolte
# -----------------------------------------------
function createYamlEnvarFile() {
    local yamlFile=$1
    local DATE=$(date +"%d-%m-%y %H:%M:%S")
    echo "---"                                             >$yamlFile
    echo "#"                                               >>$yamlFile
    echo "# dynamically created on $DATE"                  >>$yamlFile
    echo "# do not edit because it will be overwritten!"   >>$yamlFile
    echo "#"                                               >>"$yamlFile"
    echo "system_envars:"                                  >>"$yamlFile"
    PAD='                                                    '

    local result=$(env | grep "ln_")
    for item in $result; do
        key="${item%=*}"
        value="${item##*=}"

        # facciamo il padding della key e tronchiamo a max_len
        var_name="${key}:$PAD"
        var_name="${var_name:0:max_len}"
        echo "${TAB}${var_name} \"${value}\"" >> "$yamlFile"
    done
    # unset -f createYamlEnvarFile
    unset -f ${FUNCNAME[0]}

}





# -----------------------------------------------
# - Export delle variabili
# - Calcolo lunghezza massima dei nomi variabili
# -----------------------------------------------
function exportVariables() {
    max_len=0
    for key in "${!env_vars[@]}"; do
        #... Calcolo lunghezza massima delle chiavi
        len=${#key}
        (( len > max_len )) && max_len=$len

        value=$(eval echo "${env_vars[$key]}") #... Espandi la variabile (eval serve per risolvere eventuali ${VAR} nei valori)

        #... EXPORT della variabile
        export "$key=$value"
    done
    max_len=$(( $max_len + 5 ))
    # unset -f exportVariables
    unset -f ${FUNCNAME[0]}


}


