#########################################################################
#   --- dir
#   source_path='/home/loreto/filu/lnEnv/shScripts'; dirname=$(basename $source_path)
#   @createLink ${source_path} "${dest_link_path}/${dirname}" "${fEXECUTE}"
#
#   --- file
#   source_path='${HOME}/filu/lnEnv/start_proc/.desktop/sublimeStart.desktop'; dirname=$(basename $source_path)
#   @createLink ${source_path} "${dest_link_path}/${dirname}" "${fEXECUTE}"
#
#  Mandatory IMPOSTARE fEXECUTE prima della chiamata. necessaria per @lnEsegui
#########################################################################
function @createLinkForceRealPath() {
    local source_path=$1
    local dest_link_path=$2


    local real_sourcePath="$(readlink -fvs  $source_path)" # resolve links if any
    local real_destPath="$(readlink -fvs  $dest_link_path)" # resolve links if any


    if [[ ! -e "$source_path" ]]; then
        @lnLog "${cyanH}${source_path}: ${redH}not exists!${colorReset}"
        return 1

    elif [[ ! -d "$source_path" ]] && [[ ! -f "$source_path" ]]; then
        @lnLog "${cyanH}${source_path}: ${redH}is NOT a file or Directory, cannot proceed!${colorReset}"
        return 1

    elif [ ! -e "${dest_link_path}" ]; then
        echo -en "${yellowH}"
        @lnEsegui "ln -sf ${real_sourcePath} ${dest_link_path}"
        @lnEsegui "chmod -w ${real_sourcePath}"

    #... fare il test di -L prima di -d e -f
    elif [[ -L "${dest_link_path}"  ]]; then
        # set -x
        if [ "$real_destPath" == "${real_sourcePath}" ]; then
            [[ -d $real_sourcePath ]] && cmnt='dirLink' || cmnt='fileLink'
            # @lnLog "${yellowH}${cmnt} OK --> ${cyanH}${dest_link_path} ${greenH}${real_sourcePath}${colorReset}"
            @lnLog "${yellowH}${cmnt} OK:"
            @lnLog "   ${yellow}source_path: ${cyanH}${real_sourcePath}${colorReset}"
            @lnLog "   ${yellow}link_name:   ${cyanH}${dest_link_path}"
        else
            # @lnLog "${redH}wrong pointer ${real_destPath} -> ${real_sourcePath}${cyanH} creating new one ${colorReset}"
            @lnLog "${redH}wrong pointer:"
            @lnLog "    ${yellow}source_path: ${cyanH}${real_sourcePath}"
            @lnLog "    ${yellow}link_name:   ${cyanH}${real_destPath}"
            @lnLog "    ${cyanH}creating new one ${colorReset}"
            @lnEsegui "ln -sf ${real_sourcePath} ${dest_link_path}"
        # set +x
        fi

    #... controlli messi per aiutare il debug,,,,
    elif [[ -f "${dest_link_path}"  ]]; then
        @lnLog "${cyanH}${dest_link_path} - ${redH}already exists as FILE. Please remove it manually${colorReset}"
        return 1

    elif [[ -d "${dest_link_path}"  ]]; then
        @lnLog "${cyanH}${dest_link_path} - ${redH}already exists as Directory. Please remove it manually${colorReset}"
        return 1

    else
        @lnLog "${purpleH}${source_path}    unManaged${colorReset}"
        @lnLog "${purpleH}${dest_link_path} unManaged${colorReset}"
    fi
    # echo
}


function @createLink() {
    local source_path=$1
    local dest_link_path=$2

    local real_sourcePath="$(readlink -fvs  $source_path)" # resolve links if any
    local real_destPath="$(readlink -fvs  $dest_link_path)" # resolve links if any


    if [[ ! -e "$source_path" ]] && [[ ! -f "$source_path" ]]; then
        @lnLog "${cyanH}${source_path}: ${redH}is NOT a file, cannot proceed!${colorReset}"
        return 1

    # se la destinazione non esiste
    elif [ ! -e "${dest_link_path}" ]; then
        echo -en "${yellowH}"
        @lnEsegui "ln -sf ${source_path} ${dest_link_path}"
        @lnEsegui "chmod -w ${source_path}"

    #... fare il test di -L prima di -d e -f
    elif [[ -L "${dest_link_path}"  ]]; then
        if [ "$real_destPath" == "${real_sourcePath}" ]; then
            @lnLog "${yellowH}fileLink OK:"
            @lnLog "   ${yellow}source_path: ${cyanH}${source_path}${colorReset}"
            @lnLog "   ${yellow}link_name:   ${cyanH}${dest_link_path}"
        else
            @lnLog "${redH}wrong pointer:"
            @lnLog "    ${yellow}source_path: ${cyanH}${source_path}"
            @lnLog "    ${yellow}link_name:   ${cyanH}${dest_link_path}"
            @lnLog "    ${cyanH}creating new one ${colorReset}"
            @lnEsegui "ln -sf ${source_path} ${dest_link_path}"
        # set +x
        fi

    #... controlli messi per aiutare il debug,,,,
    elif [[ -f "${dest_link_path}"  ]]; then
        @lnLog "${cyanH}${dest_link_path} - ${redH}already exists as FILE. Please remove it manually${colorReset}"
        return 1

    elif [[ -d "${dest_link_path}"  ]]; then
        @lnLog "${cyanH}${dest_link_path} - ${redH}already exists as Directory. Please remove it manually${colorReset}"
        return 1

    else
        @lnLog "${purpleH}${source_path}    unManaged${colorReset}"
        @lnLog "${purpleH}${dest_link_path} unManaged${colorReset}"
    fi
    # echo
}



###########################################################
# Se la sorgente  è una directory ignoriamo
# Se la destinazione è una directory oppure mancante allora
# il filename viene creato dinamicamente nella current directory
###########################################################
function @createDirLink() {
    local source_path=$1
    local dest_link_path=${2:-.} ### se non è specificato default current directory
    local dest_link_name=${3:-} ### se non è specificato default current directory

    if [[ -d "${source_path}" && ! -d "${dest_link_path}" ]]; then
        @lnLog "${redH} per DIRECTORY LINKS i primi due parametrì devono essere delle directory${colorReset}"
        return
    fi

    ### se il link_name non è specificato dobbiamo crearlo noi
    ### costruito dal source_name come fname.lnk.extension
    if [[ -z "${dest_link_name}"  ]]; then
        name=$(basename $source_path)
        link_name="${name}.dirlink"
        [[ "${dest_link_path}" == '.' ]] && dest_link_path=""
    else
        link_name=$dest_link_name
    fi


    dest_link_path="${dest_link_path}/${link_name}"

    #... controlli messi per aiutare il debug,,,,
    if [[ -d "${dest_link_path}" || -f "${dest_link_path}" ]] && [[ ! -L "${dest_link_path}" ]]; then
        @lnLog "${cyanH}${dest_link_path} - ${redH}already exists as FILE/DIR. Please remove it manually${colorReset}"
        return 1


    # se la destinazione non esiste
    elif [ ! -e "${dest_link_path}" ]; then
        echo -en "${yellowH}"
        @lnEsegui "ln -sf ${source_path} ${dest_link_path}"
        # @lnEsegui "chmod -w ${source_path}" nella DIR non metto il read-only

    #... fare il test di -L prima di -d e -f
    elif [[ -L "${dest_link_path}"  ]]; then
        local real_sourcePath="$(readlink -fvs  $source_path)" # resolve links if any
        local real_destPath="$(readlink -fvs  $dest_link_path)" # resolve links if any
        if [ "$real_destPath" == "${real_sourcePath}" ]; then
            @lnLog "${whiteH}directory-Link OK:"
            @lnLog "   ${yellow}source_path: ${cyanH}${source_path}${colorReset}"
            @lnLog "   ${yellow}link_name:   ${cyanH}${dest_link_path}"
        else
            @lnLog "${redH}wrong pointer:"
            @lnLog "    ${yellow}source_path: ${cyanH}${source_path}"
            @lnLog "    ${yellow}link_name:   ${cyanH}${dest_link_path}"
            @lnLog "    ${cyanH}pleas remove link manually ${colorReset}"
        fi

    else
        @lnLog "${purpleH}${source_path}    unManaged${colorReset}"
        @lnLog "${purpleH}${dest_link_path} unManaged${colorReset}"
    fi

}


###########################################################
# Se la sorgente  è una directory ignoriamo
# Se la destinazione è una directory oppure mancante allora
# il filename viene creato dinamicamente nella current directory
# Syntax:
#   @createLink sourceFile destdir linkname     dest_link_path: $destdir/linkname
#   @createLink sourceFile destidir-            dest_link_path: $destdir/src_fname.lnk.extension
#   @createLink sourceFile                      dest_link_path: ./src_fname.lnk.extension
#   
#   @createLink sourceDir  destdir linkname
###########################################################
function @createLink_V2() {
    local source_path=$1
    local dest_link_path=${2:-.} 
    local dest_link_name=${3:-} ### se non è specificato default current directory

    if [[ ! -e "$source_path" ]]; then
        @lnLog "${cyanH}${source_path}: ${redH}doesn't exist!${colorReset}"
        return 1
    fi

    ### source link is a directory
    if [[ -d "${source_path}"  ]]; then
        @createDirLink "${source_path}" "${dest_link_path}" "${dest_link_name}"
        return
    fi

    ### se il link_name non è specificato dobbiamo crearlo noi
    ### costruito dal source_name come fname.lnk.extension
    if [[ -z "${dest_link_name}"  ]]; then
        filename=$(basename $source_path)
        fname="${filename%.*}"
        fext="${filename##*.}"
        link_name="${fname}.lnk.${fext}"

        if [[ "${dest_link_path}" == '.' ]]; then
            dest_link_path="${link_name}"
        else
            dest_link_path="${dest_link_path}/${link_name}"
        fi
    fi


    # source is not a file
    if [[ ! -f "$source_path" ]]; then
        @lnLog "${cyanH}${source_path}: ${redH}is NOT a file, cannot proceed!${colorReset}"
        return 1

    elif [[ -d "${dest_link_path}" || -f "${dest_link_path}" ]] && [[ ! -L "${dest_link_path}" ]]; then
        @lnLog "${cyanH}${dest_link_path} - ${redH}already exists as FILE/DIR. Please remove it manually${colorReset}"
        return 1


    # se la destinazione non esiste
    elif [ ! -e "${dest_link_path}" ]; then
        echo -en "${yellowH}"
        @lnEsegui "ln -sf ${source_path} ${dest_link_path}"
        @lnEsegui "chmod -w ${source_path}"

    #... fare il test di -L prima di -d e -f
    elif [[ -L "${dest_link_path}"  ]]; then
        local real_sourcePath="$(readlink -fvs  $source_path)" # resolve links if any
        local real_destPath="$(readlink -fvs  $dest_link_path)" # resolve links if any
        if [ "$real_destPath" == "${real_sourcePath}" ]; then
            @lnLog "${whiteH}file-Link OK:"
            @lnLog "   ${yellow}source_path: ${cyanH}${source_path}${colorReset}"
            @lnLog "   ${yellow}link_name:   ${cyanH}${dest_link_path}"
        else
            @lnLog "${redH}wrong pointer:"
            @lnLog "    ${yellow}source_path: ${cyanH}${source_path}"
            @lnLog "    ${yellow}link_name:   ${cyanH}${dest_link_path}"
            @lnLog "    ${cyanH}creating new one ${colorReset}"
            @lnEsegui "ln -sf ${source_path} ${dest_link_path}"
        fi

    else
        @lnLog "${purpleH}${source_path}    unManaged${colorReset}"
        @lnLog "${purpleH}${dest_link_path} unManaged${colorReset}"
    fi
    # echo
}



