set -u


: '
    --- da qui in poi posso usare lnLog()
'
@lnLog "running: ${yellowH}${BASH_SOURCE}${colorReset}"




# ----------------------------------------------------------
# resto delle functions presenti nella functions directory
# ----------------------------------------------------------
echo -e "\n${TABwhiteH}------------------ functions -------------------"
function_files=$(find "${ln_INIT_DIR}/functions"  -type f -name '*.functions' | sort) # *.function potrebbe essere sotto diverse directories
for filename in ${function_files}; do
    [ -f "$filename" ] || continue
    @lnLog "running: ${yellowH}${filename}${colorReset}"
    source "${filename}"
done

# ----------------------------------------------------------
