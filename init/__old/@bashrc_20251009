# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
hopt -s histappend
HISTSIZE=5000
HISTFILESIZE=10000
stty -ixon # enable ctrl-s to move backward in history (ctrl-r)

# -------------------------------------
function set_LnProfile() {
    local filename="${1:-None}"
    echo "starting... $filename"
    if [[ -f "$filename" ]]; then
        . "$filename"
    fi
}

#... non lo attiviamo per default Terminal
#... GNOME_TERMINAL_SCREEN=/org/gnome/Terminal/screen/3ef7420c_c155_48e5_bf96_7c368d1e38d4
if [[ -z "$GNOME_TERMINAL_SCREEN" ]]; then
    set_LnProfile "${HOME}/filu/lnEnv/init/Loretorc"
fi


export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
