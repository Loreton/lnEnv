# /etc/udev/rules.d/99-ln-usb-serial.rules
# sudo udevadm control --reload-rules (reload rules)
# sudo udevadm trigger (re-add all devices)
#
# TEST RULES ---> udevadm test -a -p  $(udevadm info -q path -n /dev/ttyUSB0)
# TEST RULES ---> sudo udevadm test -a -p  $(udevadm info -q path -n /dev/ttyUSB0) 2>&1| grep "98-ln-"
#
# udevadm info --attribute-walk -n /dev/ttyUSB0  |grep serial (can be used to get serial number)
# see https://wiki.archlinux.org/index.php/Bus_pirate
# for some reason, ATTRS{bInterfaceNumber}=="00" is not working, hence the use of ENV{}






# ------------------ TEST rules ---------------
# sudo udevadm test -a -p  $(udevadm info -q path -n /dev/ttyUSB0) 2>&1| grep "udev_rules_apply_to_event"

# ------------------ OK con link esplicito ---------------
# SUBSYSTEM=="tty", SUBSYSTEMS=="usb", KERNEL=="ttyUSB[0-9]*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523",  KERNELS=="1-1.5.2", SYMLINK+="arduino01"

# ------------------ OK con bash script ---------------
# SUBSYSTEM=="tty", SUBSYSTEMS=="usb", KERNEL=="ttyUSB[0-9]*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", PROGRAM="/etc/udev/rules.d/98-ln-usb-serial-parsing.sh %p", SYMLINK+="%c"

# ------------------ OK con python script ---------------
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", KERNEL=="ttyUSB[0-9]*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", PROGRAM="/etc/udev/rules.d/98-Ln-usb-parse-devpath.py %p", SYMLINK+="%c"
