##########################################################
# - return $IPADDR and $SUBNET and MASK
##########################################################
function getIpAddress {
        # set -x
    lnLogger "reading interface ${interfaceName}"
     # set -x
    isInterfaceUP=$(ip a s ${interfaceName} 2>>$_ERRORfile | grep "inet " | wc -l)

        # - Non c'è l'indirizzo. Vediamo se esiste la schedA
    if [[ "$isInterfaceUP" == "0" ]]; then
        IFC_LINE=$(ip a s ${interfaceName} 2>>$_ERRORfile | grep "${interfaceName}: " | wc -l)
        if [[ "$IFC_LINE" == "1" ]]; then
            lnLogger "trying to start interface: ${interfaceName}"
            # /sbin/ifup ${interfaceName} 2>>$_ERRORfile
            ifup ${interfaceName}
            sleep 2
        else
            lnLogger "interface ${interfaceName} NOT Found!"
        fi
        # exit
        return 1

    else
        IPADDR_LINE=$(ip a s ${interfaceName} 2>>$_ERRORfile | grep "inet ")
            # - indirizzo trovato.
        IPADDR=$(echo $IPADDR_LINE | awk '{ print $2 }'| awk -F '/' '{print $1}')
        # subnetBits=$(ip a s ${interfaceName} | grep "inet " | awk -F'/' '{ print $2 }' |  awk '{ print $1 }')

            # Read first three octets
        OCTECT_01=$(echo $IPADDR | cut -d\. -f1)
        OCTECT_02=$(echo $IPADDR | cut -d\. -f2)
        OCTECT_03=$(echo $IPADDR | cut -d\. -f3)
        SUBNET="$OCTECT_01.$OCTECT_02.$OCTECT_03"         # default
        [[ "$subnetBits" == "24" ]] && SUBNET="$OCTECT_01.$OCTECT_02.$OCTECT_03"
        MASK="${SUBNET}.0${subnetBits}"
    fi

    # exit
    return 0

}


##########################################################
# - set Rules and Routes
##########################################################
function bringUPInterface {
    lnLogger "Starting up the interface ${interfaceName}"
    lnLogger "  IP Address: ${IPADDR}"
    lnLogger "  TABLE Name: ${TABLE_NAME}"
    lnLogger "  GATEWAY:    ${GATEWAY}"
    lnLogger "  MASK:       ${MASK}"
    lnLogger "  UPping interface"
    /sbin/ifup ${interfaceName} 2>>$_ERRORfile

    # leggiamo i rule
    ruleExists=$(ip rule | egrep "$IPADDR|$TABLE_NAME" | wc -l)
    if [[ "$ruleExists" == 0 ]]; then
        lnLogger "  Adding RULES"
        CMD="       ip rule add from      $IPADDR table $TABLE_NAME"
        lnLogger $CMD
        $CMD 2>>$_ERRORfile
    fi

    lnLogger "  Adding Routes"
    CMD="       ip route add $MASK     dev $interfaceName scope link table $TABLE_NAME"
    lnLogger $CMD
    $CMD 2>>$_ERRORfile

    CMD="       ip route add default  via $GATEWAY      dev $interfaceName table $TABLE_NAME"
    lnLogger $CMD
    $CMD 2>>$_ERRORfile
}


##########################################################
# - clear Rules and Routes
##########################################################
function bringDOWNInterface {
    lnLogger "Shutting down the interface ${interfaceName}"
    # ifdown ${interfaceName}

    # lnLogger "clearing rules for interface ${interfaceName}"
    ruleExists=$(ip rule | egrep "$IPADDR|$TABLE_NAME" | wc -l)


    # ricerchiamo tutti i rule relativi all'indirizzo e li cancelliamo  se > 1
    if [[ "$ruleExists" > 1 ]]; then
        arrayRule=$(ip rule | grep $IPADDR)
        while IFS='\n' read -ra RULES; do
            for record in "${RULES[@]}"; do
                # echo $record
                rulePrefix=$(echo  "$record" | cut -d\:  -f1)
                echo $rulePrefix
                CMD="ip rule del pref $rulePrefix"
                lnLogger $CMD
                $CMD 2>>$_ERRORfile
            done
        done <<< "$arrayRule"
    fi

    CMD="ip rule del table $TABLE_NAME"
    lnLogger $CMD
    $CMD # 2>>$_ERRORfile

    # lnLogger "clearing routes for interface ${interfaceName}"
    CMD="ip route flush table $TABLE_NAME"
    lnLogger $CMD
    $CMD # 2>>$_ERRORfile
}

