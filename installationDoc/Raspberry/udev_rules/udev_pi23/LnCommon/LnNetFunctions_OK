function cleanVars {
    lnLogger ""
    interfaceName=''
    SUBNET=''
    MASK=""
    IPADDR=""

    GATEWAY=""
    TABLE_NAME=""
    statusFileName=""
    isUP=""
    lastSTATUS=""
    interfaceExists=""
}

##########################################################
# - scriviamo lo STATUS 1/0 dell'interfaccia nel file /tmp/eth0.status
# - 1 = OK
# - 0 = ERROR
##########################################################
function setOtherVars {
    GATEWAY="${SUBNET}.1"
    TABLE_NAME="$interfaceName"
    statusFileName="/tmp/${interfaceName}.status"

    interfaceExists=$(ip addr sh ${interfaceName} 2>>$_ERRORfile | grep ${interfaceName}: | wc -l); lnLogger "$interfaceName Exists? : $interfaceExists"
    if [[ "$interfaceExists" -eq "0" ]]; then
        lastSTATUS=0
        isUP=0

    else
        # read last Status
        lastSTATUS=$(head -1 <$statusFileName |  awk '{print $1;}'); lnLogger "$interfaceName lastSTATUS: $lastSTATUS"

        # read current  Status
        isUP=$(ip addr sh ${interfaceName} 2>>$_ERRORfile| grep "inet ${IPADDR}/"  | wc -l);    lnLogger "$interfaceName UP?     : $isUP"
    fi

        # save current Status
    echo "$isUP" >$statusFileName

}



