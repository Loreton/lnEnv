; ------------------------------------

[Unit]
Description=telegram bot usato per eseguire comandi su sonoff e shelly inviando comandi verso il mio Mqtt-Client
After=multi-user.target


[Service]
Environment="ENV=svil"
Environment="BROKER_NAME=LnMqtt"
Environment="BOT_NAME=LnCasettaBot"
Environment="ETC_DIR=/home/pi/.ln/etc/lnpi31"
Environment="LOGGER_DIR=/tmp/TelegramBot"
Environment="CONFIG_DIR={ETC_DIR}/config/TelegramBot"

# NON lo crea....
ExecStartPre=/bin/mkdir -m 740 -p /tmp/TelegramBot/svil
ExecStartPre=/bin/chown pi /tmp/TelegramBot/svil

# non prende le variabili
StandardOutput=file:/tmp/TelegramBot/svil/stdout.log
StandardError=file:/tmp/TelegramBot/svil/stderr.log

Type=simple
User=pi
Group=pi

        ; --config-dir $CONFIG_DIR \
        ; --logger-dir $LOGGER_DIR \
ExecStart=/usr/local/bin/python3.9 /home/pi/production/TelegramBot_svil.zip \
        --bot-name LnCasettaBot \
        --broker-name LnMqtt \
        --env svil \
        --systemd



Restart=always
RestartSec=10


[Install]
WantedBy=multi-user.target

