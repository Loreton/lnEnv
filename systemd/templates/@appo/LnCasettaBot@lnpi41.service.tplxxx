[Unit]
Description=mqtt-client used to capture data from mqtt_broker for tasmota and shelly devices
After=multi-user.target


[Service]
Type=simple
User=pi
# per gestire i child
KillMode=process

Environment="APPL_NAME=LnCasettaBot"
Environment="BROKER_NAME=LnMqtt"
Environment="BOT_NAME=LnCasettaBot"
Environment="MARIADB_SERVER=LnPi23"
Environment="LOGGER_DIR=/tmp/LnCasettaBot"
Environment="RUNTIME_DIR=/home/pi/.ln/runtime/lnpi41"

# lo stop è gestito automaticamente da systemd
ExecStart=/usr/bin/python \
            /home/pi/.ln/scripts/stable/${APPL_NAME}.zip \
            --appl-name $APPL_NAME \
            --bot-name  $BOT_NAME \
            --broker-name $BROKER_NAME \
            --runtime-dir $RUNTIME_DIR \
            --logger-dir $LOGGER_DIR \
            --logger-console error \
            --logger-level warning \
            --systemd


# Restart=always
Restart=always
RestartSec=60


[Install]
WantedBy=multi-user.target

