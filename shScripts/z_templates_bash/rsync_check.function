scriptFullPath="$(readlink -f ${BASH_SOURCE[0]})"       # OTTIMA
scriptDir="$(dirname $scriptFullPath)"
scriptName="$(basename $scriptFullPath)"

echo "----------- $scriptName"

#############################################
#
#############################################
function __RSYNC_CHECK() {
    local username=$1
    local action=$2

    if [[ "${action,,}" == 'space' ]]; then
        du -bs /mnt/Toshiba_1TB_LnDisk/sFTP/${username,,}/
        ssh pi@rmpina.duckdns.org -p 41022  "du -bs /mnt/LN1TB_A/sFTP/${username}"

    elif [[ "${action,,}" == 'ps' ]]; then
        ps ax|grep -v grep|grep rsync|grep -i "/tmp/rsync/lnpi41_${username}.*.log"

    elif [[ "${action,,}" == 'log' ]]; then
        cd /tmp/rsync && tail -f lnpi41_${username}*

    elif [[ "${action,,}" == 'console' ]]; then
        export profile="lnpi41_${username}" && log_dir="/tmp/rsync" && /bin/mkdir -p "$log_dir" && /bin/bash ${ln_SH_SCRIPTS}/rsync/rsyncLN.sh ${profile} --go --console
    fi
}


