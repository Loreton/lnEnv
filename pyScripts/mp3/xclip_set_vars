#!/bin/bash

scriptFullPath="$(readlink -f ${BASH_SOURCE[0]})"
scriptDir="$(dirname ${scriptFullPath})"

# --- top dir per dove cercare i file
extra_top_dirs_file="/tmp/xclip/extra_top_dirs.txt"
echo "${scriptDir}" >> ${extra_top_dirs_file}
echo "${HOME}/filu/myData/Songs/mp3_songs/Italiani" >>${extra_top_dirs_file}
echo "---------------------------------------"
echo "---- ${extra_top_dirs_file}"
echo "---------------------------------------"
cat $extra_top_dirs_file
echo
echo
# --- variabili d'ambiente utili per la ricerca
extra_vars_file='/tmp/xclip/extra_vars.txt'
echo "YAML_KEYPATH_SEP=__##__" >> ${extra_vars_file}
echo "selection_filename=Loreto_selection_list.yaml" >>${extra_vars_file}
echo "ITALIAN_SONGS=${HOME}/filu/myData/Songs/mp3_songs/Italiani" >>${extra_vars_file}

echo "---------------------------------------"
echo "---- ${extra_vars_file}"
echo "---------------------------------------"
cat $extra_vars_file
echo
